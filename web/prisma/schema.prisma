generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isAdmin      Boolean  @default(false) @map("is_admin")
  emailVerified Boolean @default(false) @map("email_verified")
  verificationToken          String?   @unique @map("verification_token") @db.VarChar(64)
  verificationTokenExpiresAt DateTime? @map("verification_token_expires_at") @db.Timestamptz(6)
  /// IANA zone reported by the browser. Time-of-day insights are meaningless
  /// without it — the server's clock says nothing about when the user works.
  timezone     String?  @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dsaProgress DsaProblemProgress[]
  projects    Project[]
  aiUsage     AiUsage[]
  feedback    Feedback[]
  roadmapProgress RoadmapProgress[]

  @@map("users")
}

/// Roadmap content itself lives in code (lib/roadmaps/content.ts), the same
/// way DSA problems do — this only records which steps a user has ticked off.
model RoadmapProgress {
  userId      Int      @map("user_id")
  roadmapSlug String   @map("roadmap_slug") @db.VarChar(100)
  stepId      String   @map("step_id") @db.VarChar(120)
  done        Boolean  @default(false)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roadmapSlug, stepId])
  @@map("roadmap_progress")
}

/// One row per user per day, counting AI calls so a single person can't
/// exhaust the shared provider quota for everyone else.
model AiUsage {
  id     Int    @id @default(autoincrement())
  userId Int    @map("user_id")
  day    String @db.VarChar(10)
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("ai_usage")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  message   String
  page      String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("feedback")
}

model DsaTopic {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  progress DsaProblemProgress[]

  @@map("dsa_topics")
}

model DsaProblemProgress {
  userId    Int      @map("user_id")
  topicSlug String   @map("topic_slug") @db.VarChar(100)
  problemId Int      @map("problem_id")
  status    String   @db.VarChar(20)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic DsaTopic @relation(fields: [topicSlug], references: [slug], onDelete: Cascade)

  @@id([userId, topicSlug, problemId])
  @@map("dsa_problem_progress")
}

enum ProjectStatus {
  planning
  active
  completed
}

model Project {
  id          Int           @id @default(autoincrement())
  userId      Int           @map("user_id")
  name        String
  description String
  status      ProjectStatus @default(active)
  tech        String[]      @default([])
  nextStep    String        @default("") @map("next_step")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks ProjectTask[]

  @@map("projects")
}

model ProjectTask {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_tasks")
}
